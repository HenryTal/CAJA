<link rel="stylesheet" href="/css/navbar.css">

<div class="navbar">
    <div class="container">
        <a href="/" class="left">
            <img src="/img/logo.png" alt="Compara y Ahorra en tus Juegos Aquí." aria-label="Compara y Ahorra en tus Juegos Aquí." title="Compara y Ahorra en tus Juegos Aquí." class="logo">
        </a>
        <ul class="menu">
            <li class="item-menu platforms">
                <span class="link category">Plataformas</span>
                <ul class="platform list"></ul>
            </li>
            <li class="item-menu genres">
                <span class="link category">Generos</span>
                <ul class="genre list"></ul>
            </li>
            <li class="item-menu shops">
                <span class="link category">Generos</span>
                <ul class="shop list"></ul>
            </li>
            <li class="item-menu">
                <form action="/search" id="formSearch">
                    <div class="field search" data-label="Buscar un Juego">
                        <input type="text" name="query" id="inputSearch" placeholder="Buscar un Juego">
                    </div>
                    <button type="submit" class="button"><i class="ri-search-2-line"></i></button>
                </form>
            </li>
        </ul>
        <div class="containerSettings">
            <div id="changeTheme" aria-label="Cambiar tema." title="Cambiar tema.">
                <i class="ri-moon-fill"></i>
            </div>
            <div id="dataUser">
                <div class="profile">
                    <i class="ri-user-5-fill"></i>
                    <img src="" alt="" class="image img-loading">
                </div>
                <ul class="settings">
                </ul>
            </div>
        </div>
    </div>
    <div id="statusConnection">
        <span class="message"></span>
    </div>
</div>

<script src="/js/navbar.js"></script>